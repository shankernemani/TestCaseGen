# Copy to .env and fill in.
DATABASE_URL="file:./dev.db"

# Anthropic API key — used server-side only, never exposed to the client.
ANTHROPIC_API_KEY=""

# Models (defaults per spec; override if needed)
CHAT_MODEL="claude-sonnet-4-6"
BACKGROUND_MODEL="claude-haiku-4-5"

# Secret for signing the httpOnly session cookie. Change in production.
SESSION_SECRET="change-me-to-a-long-random-string"

# Login PINs are set at seed time (see prisma/seed.ts). Override here before seeding:
SEED_STUDENT_PIN="1008"
SEED_PARENT_PIN="2653"
