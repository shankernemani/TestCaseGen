# Copy to .env and fill in.
ANTHROPIC_API_KEY=sk-ant-...
DATABASE_URL="file:./dev.db"

# Optional overrides
PATHFINDER_CHAT_MODEL=claude-sonnet-4-6
PATHFINDER_BACKGROUND_MODEL=claude-haiku-4-5

# Initial PINs for the two profiles (used by prisma/seed.ts on FIRST creation
# only; change them later in the app via Profile → Change PIN). To force-reset
# existing PINs from a re-seed, also set SEED_ROTATE_PINS=1 for that one run.
SEED_STUDENT_PIN=1213
SEED_PARENT_PIN=2026
